# SafeTx + MagicBlock Ephemeral Rollups Configuration
# No API keys required - uses public endpoints only

# Environment
ENV=development

# Solana RPC Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com

# MagicBlock Public Router (No authentication required)
MAGICBLOCK_ROUTER=https://devnet-router.magicblock.app

# Server Configuration
PORT=5000

# Streaming Configuration (metrics sent every 2 seconds)
METRICS_INTERVAL=2000
